{
  "name": "@relution/appport",
  "version": "0.1.0-alpha.4",
  "description": "Self-service software for managed Windows devices.",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=26.5.0 <26.6.0"
  },
  "scripts": {
    "client:typecheck": "pnpm --dir apps/windows-client exec tsc --noEmit",
    "client:test": "pnpm --dir apps/windows-client test",
    "client:test:coverage": "pnpm --dir apps/windows-client test:coverage",
    "client:build": "pnpm --dir apps/windows-client build",
    "client:rust:test": "cargo test --manifest-path apps/windows-client/src-tauri/Cargo.toml",
    "client:rust:check": "cargo check --manifest-path apps/windows-client/src-tauri/Cargo.toml",
    "client:rust:fmt": "cargo fmt --manifest-path apps/windows-client/src-tauri/Cargo.toml --check",
    "client:rust:clippy": "cargo clippy --manifest-path apps/windows-client/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "client:tauri": "pnpm --dir apps/windows-client tauri build",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "docs:verify": "node --test scripts/verify-docs.test.mjs && node scripts/verify-docs.mjs",
    "evidence:test": "node --test scripts/create-alpha-evidence.test.mjs",
    "verify": "pnpm verify:toolchain && pnpm format:check && pnpm docs:verify && pnpm evidence:test && pnpm client:typecheck && pnpm client:test:coverage && pnpm client:build && pnpm client:rust:fmt && pnpm client:rust:clippy && pnpm client:rust:test && pnpm client:rust:check",
    "alpha:evidence": "node scripts/create-alpha-evidence.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
