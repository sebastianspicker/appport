{
  "name": "@relution/appport",
  "version": "0.1.0-alpha.4",
  "description": "Self-service software for managed Windows devices.",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=26.5.0 <26.6.0"
  },
  "scripts": {
    "frontend:check": "pnpm --dir apps/windows-client exec tsc --noEmit",
    "frontend:test": "pnpm --dir apps/windows-client test",
    "frontend:build": "pnpm --dir apps/windows-client build",
    "demo:check": "pnpm --dir apps/web-demo check",
    "demo:test": "pnpm --dir apps/web-demo test",
    "demo:build": "pnpm --dir apps/web-demo build",
    "demo:artifact-check": "node scripts/verify-demo-artifact.mjs",
    "demo:verify": "pnpm demo:check && pnpm demo:test && pnpm demo:build && pnpm demo:artifact-check && pnpm quality:demo",
    "rust:test": "cargo test --manifest-path apps/windows-client/src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path apps/windows-client/src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path apps/windows-client/src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path apps/windows-client/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "windows:package": "pnpm --dir apps/windows-client tauri build",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "docs:verify": "node scripts/verify-docs.mjs",
    "architecture:check": "node scripts/verify-architecture.mjs",
    "tooling:test": "node --test scripts/check-source-size.test.mjs scripts/source-gates.test.mjs scripts/verify-architecture.test.mjs scripts/verify-demo-artifact.test.mjs scripts/verify-docs.test.mjs scripts/workflow-contracts.test.mjs",
    "evidence:test": "node --test scripts/create-alpha-evidence.test.mjs",
    "qualification:check": "node --test scripts/alpha-evidence/configuration.test.mjs",
    "quality:lint:source": "eslint --max-warnings 0 eslint.config.mjs stylelint.config.mjs apps/windows-client scripts",
    "quality:style:source": "stylelint --max-warnings 0 \"apps/windows-client/**/*.css\"",
    "quality:size:source": "node scripts/check-source-size.mjs --cohort source",
    "quality:duplicates:source": "node scripts/check-duplicates.mjs --cohort source",
    "quality:source:static": "pnpm quality:lint:source && pnpm quality:style:source && pnpm quality:size:source && pnpm quality:duplicates:source",
    "quality:source": "pnpm quality:source:static && node scripts/verify-source.mjs --gate rust-clippy",
    "quality:lint:demo": "eslint --max-warnings 0 apps/web-demo",
    "quality:style:demo": "stylelint --max-warnings 0 \"apps/web-demo/**/*.css\"",
    "quality:size:demo": "node scripts/check-source-size.mjs --cohort demo",
    "quality:duplicates:demo": "node scripts/check-duplicates.mjs --cohort demo",
    "quality:demo": "pnpm quality:lint:demo && pnpm quality:style:demo && pnpm quality:size:demo && pnpm quality:duplicates:demo",
    "quality:check": "pnpm quality:source && pnpm quality:demo",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "pnpm verify:source",
    "evidence:alpha": "node scripts/create-alpha-evidence.mjs",
    "alpha:evidence": "pnpm evidence:alpha"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jscpd": "5.1.2",
    "prettier": "3.6.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript-eslint": "8.69.0"
  }
}
