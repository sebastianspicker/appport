{
  "name": "@relution/appport",
  "version": "0.1.0-alpha.4",
  "description": "Self-service software for managed Windows devices.",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=26.5.0 <26.6.0"
  },
  "scripts": {
    "frontend:check": "pnpm --dir apps/windows-client exec tsc --noEmit",
    "frontend:test": "pnpm --dir apps/windows-client test",
    "frontend:build": "pnpm --dir apps/windows-client build",
    "rust:test": "cargo test --manifest-path apps/windows-client/src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path apps/windows-client/src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path apps/windows-client/src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path apps/windows-client/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "windows:package": "pnpm --dir apps/windows-client tauri build",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "docs:verify": "node scripts/verify-docs.mjs",
    "architecture:check": "node scripts/verify-architecture.mjs",
    "evidence:test": "node --test scripts/create-alpha-evidence.test.mjs",
    "qualification:check": "node --test scripts/alpha-evidence/configuration.test.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "pnpm verify:source",
    "evidence:alpha": "node scripts/create-alpha-evidence.mjs",
    "alpha:evidence": "pnpm evidence:alpha"
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
